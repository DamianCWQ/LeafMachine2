# ─────────────────────────────────────────────────────────────────────────────
# LeafMachine2 Execution Service — environment configuration
#
# Copy this file to .env and fill in the values for your deployment.
# Never commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Service authentication ────────────────────────────────────────────────────
# Shared secret between Laravel and this service.
# Laravel sends this in the X-API-Key header on every request.
# Use a long random string: python -c "import secrets; print(secrets.token_hex(32))"
LM2_API_KEY=changeme-generate-a-real-secret

# ── Paths on the LeafMachine server ──────────────────────────────────────────
# Absolute path to the root of the LeafMachine2 repository on this server.
# Defaults to the parent of the api/ directory if not set.
LM2_HOME=/srv/leafmachine2

# Absolute path to the directory where Laravel uploads land.
# All uploaded image files are stored under  LM2_UPLOAD_DIR/<job_id>/
# and this path is the only location the service will accept as input.
LM2_UPLOAD_DIR=/srv/leafmachine2/uploads

# Absolute path to the directory where pipeline outputs are written.
# All results are stored under  LM2_OUTPUT_DIR/<job_id>/
LM2_OUTPUT_DIR=/srv/leafmachine2/outputs

# ── Network ───────────────────────────────────────────────────────────────────
# Port Uvicorn listens on. Should be firewalled to allow only the Laravel
# server IP (and health-check probes) to reach this port.
PORT=5000

# ── Laravel callback ─────────────────────────────────────────────────────────
# Base URL of the internal status-update endpoint on the Laravel server.
# The service appends  /<job_id>/status  when posting callbacks.
# Example: https://myapp.com/api/internal/leafmachine/jobs
# Leave blank to disable outbound callbacks (useful for local testing).
LARAVEL_CALLBACK_URL=https://myapp.example.com/api/internal/leafmachine/jobs

# Bearer token the Python service sends when posting callbacks to Laravel.
# Laravel validates this before updating the MySQL job row.
# Must match LEAFMACHINE_CALLBACK_TOKEN in your Laravel .env.
# Use a long random string: python -c "import secrets; print(secrets.token_hex(32))"
LARAVEL_CALLBACK_TOKEN=changeme-generate-a-real-token

# Include a structured result_artifacts array in final callbacks.
# Keep enabled so Laravel can persist segmented image references for display.
CALLBACK_INCLUDE_RESULT_ARTIFACTS=true

# Optional caps to prevent oversized callback payloads on very large jobs.
# A non-positive value disables the corresponding cap.
CALLBACK_MAX_RESULT_FILES=30000
CALLBACK_MAX_RESULTS_DATA=20000
CALLBACK_MAX_MEASUREMENT_RECORDS=20000
CALLBACK_MAX_RESULT_ARTIFACTS=40000
